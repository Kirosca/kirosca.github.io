---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', path: '/#top' },
  { name: '画作', path: '/#artworks' },
  { name: '软件', path: '/#projects' },
  { name: '文章', path: '/#posts' },
];
---

<header class="navbar" transition:persist>
  <a href="/#top" class="nav-brand">
    <span class="nav-brand-dot"></span>
    Kirosca
  </a>

  <nav class="nav-links">
    {navItems.map((item) => (
      <a
        href={item.path}
        class="nav-link"
      >
        {item.name}
      </a>
    ))}
  </nav>
</header>
