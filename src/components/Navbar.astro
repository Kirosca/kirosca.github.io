---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '首页', path: '/#top' },
  { name: '技术美术', path: '/#tech-art' },
  { name: '视觉艺术', path: '/#gallery' },
  { name: '软件工具', path: '/#projects' },
  { name: '文章专栏', path: '/#posts' },
];
---

<header class="navbar">
  <a href="/#top" class="nav-brand">
    <span class="nav-brand-dot"></span>
    Kirosca
  </a>

  <nav class="nav-links">
    {navItems.map((item) => (
      <a
        href={item.path}
        class="nav-link"
      >
        {item.name}
      </a>
    ))}
  </nav>
</header>
