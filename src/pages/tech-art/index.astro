---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShaderToyCanvas from '../../components/ShaderToyCanvas.astro';
import ChannelSplitter from '../../components/ChannelSplitter.astro';
import { getCollection } from 'astro:content';

const allTechArt = await getCollection('techArt');
const activeTechArt = allTechArt
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const shaders = activeTechArt.filter((t) => t.data.category === 'shader');
const pipelines = activeTechArt.filter((t) => t.data.category === 'pipeline');
const materials = activeTechArt.filter((t) => t.data.category === 'material');
---

<BaseLayout
  title="技术美术工坊 (TA Labs) | Kirosca"
  description="Kirosca 的技术美术作品库：实时 WebGL 着色器、PBR 材质管线与引擎自动化工具"
>
  <section style="padding: 20px 0 10px;">
    <div class="section-title-wrap">
      <div class="section-title">技术美术工坊（Tech-Art Labs）</div>
      <a href="/#tech-art" class="section-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        返回首页
      </a>
    </div>
    <p style="color: var(--text-muted); font-size: 14.5px; margin-bottom: 28px;">
      专注于渲染管线定制、实时着色器 (Shader) 算法与次世代 PBR 材质工作流。可在下方直接调节 Shader 参数或切换贴图通道。
    </p>

    <!-- 1. 实时 Shader 实验台 -->
    <div style="margin-bottom: 32px;">
      <ShaderToyCanvas title="实时 GLSL 片元着色器演练 (Interactive Shader)" />
    </div>

    <!-- 2. PBR 材质通道解构台 -->
    <div style="margin-bottom: 36px;">
      <ChannelSplitter title="PBR 材质通道与切线空间法线检视" />
    </div>

    <!-- 3. 管线工具与算法拆解卡片 -->
    <div style="margin-bottom: 36px;">
      <div class="section-title" style="font-size: 18px; margin-bottom: 16px;">引擎管线工具与资产优化 (Tools & Pipelines)</div>
      <div class="grid-cards">
        {pipelines.map((item) => (
          <div class="card">
            <div class="card-top">
              <div class="card-header">
                <span class="card-title">{item.data.title}</span>
                <span class="card-icon" style="color: #c084fc;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                  </svg>
                </span>
              </div>
              <p class="card-desc">{item.data.description}</p>
            </div>
            <div class="tags">
              {item.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}

        {materials.map((item) => (
          <div class="card">
            <div class="card-top">
              <div class="card-header">
                <span class="card-title">{item.data.title}</span>
                <span class="card-icon" style="color: #38bdf8;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83M16.62 12l-5.74 9.94"></path>
                  </svg>
                </span>
              </div>
              <p class="card-desc">{item.data.description}</p>
            </div>
            <div class="tags">
              {item.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>