---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const allArtworks = await getCollection('artworks');
const featuredArtworks = allArtworks.slice(0, 3);

const allPosts = await getCollection('posts');
const recentPosts = allPosts.slice(0, 2);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding: 20px 0 10px;">
    <div style="position: relative; width: 110px; height: 110px;">
      <img
        src="https://avatars.githubusercontent.com/u/35485370?v=4"
        alt="Kirosca Avatar"
        style="width: 100%; height: 100%; border-radius: 50%; border: 3px solid rgba(255, 255, 255, 0.15); background: #1e293b; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 25px var(--glow); object-fit: cover;"
      />
    </div>

    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 14px; border-radius: 9999px; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); color: var(--primary-light); font-size: 13px; font-weight: 600;">
      <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px #22c55e;"></span>
      Building, Drawing & Sharing
    </div>

    <h1 style="font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.5px; background: linear-gradient(135deg, #ffffff 40%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Kirosca
    </h1>

    <p style="color: var(--text-muted); font-size: 16px; max-width: 580px; line-height: 1.7;">
      专注于跨平台开发、开源工具构建、数字绘画研究与现代 Web 体验设计。探索技术与创意的边界。
    </p>

    <div class="links-bar" style="margin-top: 6px;">
      <a href="https://github.com/Kirosca" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        GitHub
      </a>

      <a href="https://greasyfork.org/zh-CN/users/815643-kirosca" target="_blank" rel="noopener noreferrer" class="btn btn-glass">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
          <path d="M2 17l10 5 10-5"></path>
          <path d="M2 12l10 5 10-5"></path>
        </svg>
        Greasy Fork
      </a>

      <a href="https://www.bilibili.com/opus/1231629834092806164" target="_blank" rel="noopener noreferrer" class="btn btn-glass">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect>
          <polyline points="17 2 12 7 7 2"></polyline>
        </svg>
        B站专栏
      </a>

      <a href="https://afdian.com/a/Kirosca" target="_blank" rel="noopener noreferrer" class="btn btn-afdian">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        爱发电
      </a>

      <a href="mailto:addpd@qq.com" class="btn btn-glass">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        联系我
      </a>
    </div>
  </section>

  <!-- Section 1: 画作展示速览 -->
  <section>
    <div class="section-title-wrap">
      <div class="section-title">画作与视觉作品</div>
      <a href="/artworks" class="section-more">
        进入完整画廊
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
    <div class="grid-cards">
      {featuredArtworks.map((art) => (
        <ArtworkCard
          title={art.data.title}
          description={art.data.description}
          tags={art.data.tags}
          imageUrl={art.data.imageUrl}
          date={art.data.date}
        />
      ))}
    </div>
  </section>

  <!-- Section 2: 软件与脚本 -->
  <section>
    <div class="section-title-wrap">
      <div class="section-title">开源软件 & 油猴脚本</div>
      <a href="/projects" class="section-more">
        查看全部项目
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
    <div class="grid-cards">
      {featuredProjects.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          tags={p.data.tags}
          url={p.data.url}
          category={p.data.category}
        />
      ))}
    </div>
  </section>

  <!-- Section 3: 文章与专栏 -->
  <section>
    <div class="section-title-wrap">
      <div class="section-title">文章与技巧分享</div>
      <a href="/posts" class="section-more">
        浏览全部文章
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
    <div class="grid-cards">
      {recentPosts.map((post) => (
        <PostCard
          title={post.data.title}
          summary={post.data.summary}
          date={post.data.date}
          tags={post.data.tags}
          url={post.data.externalUrl || `/posts/${post.id}`}
          isExternal={!!post.data.externalUrl}
        />
      ))}
    </div>
  </section>
</BaseLayout>
