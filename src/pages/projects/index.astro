---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const activeProjects = allProjects.filter((p) => !p.data.draft);

const apps = activeProjects.filter((p) => p.data.category === 'app' || p.data.category === 'tool');
const userscripts = activeProjects.filter((p) => p.data.category === 'userscript');
const archives = activeProjects.filter((p) => p.data.category === 'archive');
---

<BaseLayout title="开源软件与脚本 | Kirosca" description="Kirosca 开发的开源客户端、实用油猴脚本与工程工具">
  <section style="padding: 20px 0 10px;">
    <div class="section-title-wrap">
      <div class="section-title">开源软件 & 油猴脚本（Projects）</div>
      <a href="/#projects" class="section-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        返回首页
      </a>
    </div>
    <p style="color: var(--text-muted); font-size: 14.5px; margin-bottom: 32px;">
      以解决实际痛点为核心，涵盖 Android 客户端、现代浏览器用户脚本与效率工具。
    </p>

    <!-- 实用油猴扩展 -->
    <div style="margin-bottom: 36px;">
      <div class="section-title" style="font-size: 18px; margin-bottom: 16px;">油猴扩展与浏览器脚本 (Userscripts)</div>
      <div class="grid-cards">
        {userscripts.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            url={p.data.url}
          />
        ))}
      </div>
    </div>

    <!-- 客户端与独立工具 -->
    <div style="margin-bottom: 36px;">
      <div class="section-title" style="font-size: 18px; margin-bottom: 16px;">客户端与桌面应用 (Apps & Tools)</div>
      <div class="grid-cards">
        {apps.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            url={p.data.url}
          />
        ))}
      </div>
    </div>

    <!-- 归档与文档库 -->
    {archives.length > 0 && (
      <div>
        <div class="section-title" style="font-size: 18px; margin-bottom: 16px;">开源文档与历史归档 (Archives)</div>
        <div class="grid-cards">
          {archives.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              url={p.data.url}
            />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
