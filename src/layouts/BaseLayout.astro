---
import Navbar from '../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kirosca | Personal Homepage',
  description = 'Kirosca 的个人主页 - 跨平台开发、开源工具、数字绘画与文章专栏',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script>
      function getPageDepth(pathname: string) {
        const clean = pathname.replace(/\/+$/, '') || '/';
        if (clean === '/') return 0;
        return clean.split('/').filter(Boolean).length;
      }

      const peerOrder: Record<string, number> = {
        '/': 0,
        '/artworks': 1,
        '/projects': 2,
        '/posts': 3,
      };

      document.addEventListener('astro:before-preparation', (event) => {
        const fromPath = event.from.pathname.replace(/\/+$/, '') || '/';
        const toPath = event.to.pathname.replace(/\/+$/, '') || '/';

        // 同页面内 hash 锚点定位，彻底清除方向属性，保持原生平滑上下滚动
        if (fromPath === toPath) {
          document.documentElement.removeAttribute('data-transition-direction');
          return;
        }

        const fromDepth = getPageDepth(fromPath);
        const toDepth = getPageDepth(toPath);

        let isBack = false;
        if (event.direction === 'back') {
          isBack = true;
        } else if (event.direction === 'forward') {
          isBack = false;
        } else if (toDepth < fromDepth) {
          // 目标深度更浅（二级/三级返回上级、返回首页） -> 从左到右
          isBack = true;
        } else if (toDepth > fromDepth) {
          // 目标深度更深（首页去二级、二级去三级） -> 从右到左
          isBack = false;
        } else {
          // 同级切换：按导航栏水平顺序判定
          const fromOrder = peerOrder[fromPath] ?? 0;
          const toOrder = peerOrder[toPath] ?? 0;
          isBack = toOrder < fromOrder;
        }

        const direction = isBack ? 'back' : 'forward';
        event.direction = direction;
        document.documentElement.setAttribute('data-transition-direction', direction);
      });

      document.addEventListener('astro:after-swap', () => {
        // 若目标路径无指定锚点（如直接点击返回首页），瞬时重置至页面最顶部 (0, 0)
        if (!window.location.hash) {
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        }
      });

      document.addEventListener('astro:page-load', () => {
        document.documentElement.removeAttribute('data-transition-direction');
      });
    </script>
  </head>
  <body>
    <div class="bg-blobs" transition:persist>
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="container">
      <Navbar currentPath={currentPath} />

      <main class="page-main">
        <slot />
      </main>

      <footer>
        <p>
          © 2026 Kirosca · 
          <a href="https://www.bilibili.com/opus/1231629834092806164" target="_blank" rel="noopener noreferrer">B站专栏</a> · 
          <a href="https://greasyfork.org/zh-CN/users/815643-kirosca" target="_blank" rel="noopener noreferrer">Greasy Fork</a> · 
          <a href="https://afdian.com/a/Kirosca" target="_blank" rel="noopener noreferrer">爱发电支持</a> · 
          Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> & <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
        </p>
      </footer>
    </div>
  </body>
</html>
